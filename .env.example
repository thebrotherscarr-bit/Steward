OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=steward:1

# The install's own entries (harness/steward/install.py; ExecPlan 0006 P1). Empty means the default.
# STEWARD_WORKSPACE: the folder Steward works in (default: this repository).
STEWARD_WORKSPACE=
# STEWARD_OWNER: who Steward works for, as his instructions name them (default: Kyle).
STEWARD_OWNER=
# STEWARD_BASH: the bash his shell runs on Windows (default: Git for Windows under %ProgramFiles%).
STEWARD_BASH=
# STEWARD_GROUND_DIR: Manjuel's ground, if this install has one (default: inferred from the folder layout, else none).
STEWARD_GROUND_DIR=
# STEWARD_MCP_PORT: the port of his MCP host, mcp_app.py (default: 43121).
STEWARD_MCP_PORT=

# SecondBrain MCP (stage 1). The key is yours to paste from SecondBrain -> Settings -> Share.
SECONDBRAIN_MCP_URL=http://127.0.0.1:43110/mcp
SECONDBRAIN_MCP_KEY=
